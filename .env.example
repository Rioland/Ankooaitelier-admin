# Same Neon database as the storefront (copy DATABASE_URL from the storefront project)
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require"

# Long random string used to sign admin sessions (e.g. `openssl rand -base64 32`)
AUTH_SECRET="replace-with-a-long-random-string"

# Bootstrap admin — used to create the first account. After first login this is
# stored in the `admins` table; manage further admins from the Admins page.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"

# Public URL of the storefront (used for "View store" / "View product" links)
NEXT_PUBLIC_STORE_URL="https://ankooaitelier.vercel.app"

# Same Vercel Blob store as the storefront, so uploaded product images are public URLs
BLOB_READ_WRITE_TOKEN=""
